{
  "name": "pixelforge-studio",
  "version": "1.0.0",
  "private": true,
  "description": "PixelForge Studio: a layered, client-side image editor that runs entirely in your browser",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node -e \"require('fs').accessSync('public/index.html')\"",
