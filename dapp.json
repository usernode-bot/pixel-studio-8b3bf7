{
  "description": "PixelForge Studio: a layered, client-side image editor that runs entirely in your browser",
  "icon": {
    "emoji": "🖼️"
  },
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  },
  "bootParams": ["demo"],
  "tests": [
    {
      "name": "Empty workspace",
      "path": "/",
      "expectSelector": "[data-workspace]",
      "expectText": "Open"
    },
    {
      "id": "demo-editor",
      "name": "Demo document with layers",
      "path": "/?demo=1",
      "expectSelector": "[data-stage-canvas]",
      "expectText": "Layers",
      "visual": true,
      "impact": ["public/**", "styles/**"]
    },
    {
      "name": "Demo layers listed",
      "path": "/?demo=1",
      "expectText": "Harbour at sunrise"
    },
    {
      "name": "Demo is labelled",
      "path": "/?demo=1",
      "expectSelector": "[data-usernode-demo-note]",
      "expectText": "Staging demo"
    }
  ]
}